<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Property Setup"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Address"
            android:inputType="textPostalAddress" />

        <EditText
            android:id="@+id/editUnitNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Unit Number (Optional)"
            android:inputType="text" />

        <EditText
            android:id="@+id/editBedrooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Bedrooms"
            android:inputType="number"
            android:text="2" />

        <EditText
            android:id="@+id/editBathrooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Bathrooms"
            android:inputType="number"
            android:text="1" />

        <CheckBox
            android:id="@+id/checkGarage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Has Garage" />

        <CheckBox
            android:id="@+id/checkBasement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Has Basement" />

        <CheckBox
            android:id="@+id/checkYard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:checked="true"
            android:text="Has Yard" />

        <Button
            android:id="@+id/buttonGenerateChecklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Generate Checklist" />

        <Button
            android:id="@+id/buttonStartMoveIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Start Move In" />

        <Button
            android:id="@+id/buttonStartMoveOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Start Move Out" />

        <Button
            android:id="@+id/buttonStartNewRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start New Run" />

        <TextView
            android:id="@+id/textSetupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#EDEDED"
            android:padding="10dp"
            android:text="Setup ready." />
    </LinearLayout>
</ScrollView>
