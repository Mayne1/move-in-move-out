<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textPropertyDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Property"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textPropertyDetailSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Details" />

    <Button
        android:id="@+id/buttonShareProperty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Share with Tenant" />

    <Button
        android:id="@+id/buttonOpenComparisonReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Comparison Report" />
</LinearLayout>
