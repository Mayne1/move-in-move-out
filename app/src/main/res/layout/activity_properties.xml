<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textPropertiesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Properties"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editPropertyAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="Address line"
            android:inputType="textPostalAddress" />

        <EditText
            android:id="@+id/editPropertyUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="Unit (optional)"
            android:inputType="text" />

        <EditText
            android:id="@+id/editPropertyCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="City"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/editPropertyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="State"
            android:inputType="textCapCharacters" />

        <EditText
            android:id="@+id/editPropertyZip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Zip"
            android:inputType="number" />

        <Button
            android:id="@+id/buttonCreateProperty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Create Property" />

        <TextView
            android:id="@+id/textPropertiesStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Loading..." />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProperties"
            android:layout_width="match_parent"
            android:layout_height="400dp" />
    </LinearLayout>
</ScrollView>
